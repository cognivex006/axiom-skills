{
  "schema_version": 1,
  "repository": "axiom-skills",
  "check": [
    [
      "python",
      "-m",
      "pytest",
      "tests",
      "-q",
      "-p",
      "no:cacheprovider"
    ],
    [
      "python",
      "release/verify_spec_pin.py"
    ],
    [
      "python",
      "release/verify_manifest.py"
    ],
    [
      "python",
      "release/build_plugin_bundle.py"
    ]
  ],
  "build": [
    [
      "python",
      "-m",
      "release.build_github_release",
      "--tag",
      "v0.1.15",
      "--out",
      "{out}"
    ]
  ]
}
